# Скопировать в .env.deploy.local (он в .gitignore) и заполнить.
# Используется скриптами scripts/deploy_full.py и scripts/deploy_ssh.py.

# SSH к боевому серверу
SUUPR_SSH_HOST=72.56.38.35
SUUPR_SSH_USER=root
SUUPR_SSH_PASSWORD=replace-me

# БД на боевом сервере (создаётся deploy_full.py)
SUUPR_DB_NAME=suupr
SUUPR_DB_USER=suupr
SUUPR_DB_PASSWORD=replace-me-with-strong-password

# JWT-секреты (длинные случайные строки, минимум 32 символа)
SUUPR_JWT_SECRET=replace-me-with-32+chars
SUUPR_JWT_REFRESH_SECRET=replace-me-with-32+chars-different-from-jwt

# Опционально
SUUPR_BACKEND_PORT=8000
