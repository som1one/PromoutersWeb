APP_NAME=СУУПР Backend
APP_ENV=local
APP_DEBUG=true
API_V1_PREFIX=/api/v1

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=promouters
POSTGRES_USER=promouters
POSTGRES_PASSWORD=promouters

LOG_LEVEL=INFO
LOG_JSON=false
LOG_CONFIG_PATH=config/logging.yaml
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

JWT_SECRET=change-me-generate-with-openssl-rand-base64-32
JWT_EXPIRATION_TIME=3600
JWT_ALGORITHM=HS256
JWT_REFRESH_SECRET=change-me-different-from-access-secret
JWT_REFRESH_EXPIRATION_TIME=86400
JWT_REFRESH_ALGORITHM=HS256

AUTH_SMS_ENABLED=false
AUTH_SMS_CODE_TTL_SECONDS=300
AUTH_SMS_CODE_LENGTH=6
AUTH_SMS_MAX_ATTEMPTS=5

SMS_RU_API_ID=
SMS_RU_FROM=
SMS_RU_TEST=true

MEDIA_ROOT=media
MEDIA_URL=http://127.0.0.1:8000/media
PHOTO_REPORT_REMINDER_MINUTES=30

# VK bot — push-уведомления мастерам о новых/назначенных заявках.
# Тот же токен сообщества, что использует бот (Valeriy/PythonProject2).
# Без него ВК-уведомления мастерам не отправляются.
VK_BOT_TOKEN=
VK_GROUP_ID=
