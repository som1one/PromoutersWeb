APP_NAME=СУУПР Backend
APP_ENV=production
APP_DEBUG=false
API_V1_PREFIX=/api/v1

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=promouters
POSTGRES_USER=promouters
POSTGRES_PASSWORD=change-me

LOG_LEVEL=INFO
LOG_JSON=true
LOG_CONFIG_PATH=config/logging.yaml

JWT_SECRET=change-me-access-secret
JWT_EXPIRATION_TIME=3600
JWT_ALGORITHM=HS256
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRATION_TIME=86400
JWT_REFRESH_ALGORITHM=HS256

AUTH_SMS_ENABLED=true
AUTH_SMS_CODE_TTL_SECONDS=300
AUTH_SMS_CODE_LENGTH=6
AUTH_SMS_MAX_ATTEMPTS=5

SMS_RU_API_ID=
SMS_RU_FROM=
SMS_RU_TEST=false

MEDIA_ROOT=media
MEDIA_URL=https://api.example.com/media
PHOTO_REPORT_REMINDER_MINUTES=30
